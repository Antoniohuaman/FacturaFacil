+        mediosPago: [crearMedioEfectivo(50)],
+        claveIdempotencia: 'clave-5',
+        pagosExistentes: [],
+        mediosDisponibles: MEDIOS_DISPONIBLES,
+        cajaAbierta: false,
+        seriePG: 'PG01',
+        registrarCaja: async () => {},
